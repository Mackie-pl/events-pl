{
  "name": "events-pl",
  "version": "0.3.0",
  "type": "module",
  "description": "2-stage local events aggregation pipeline (discovery + daily extraction) via OpenRouter",
  "repository": "github:Mackie-pl/events-pl",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "daily": "tsx --env-file-if-exists=.env src/actions/daily.ts",
    "digest": "tsx --env-file-if-exists=.env src/actions/digest.ts",
    "discover": "tsx --env-file-if-exists=.env src/actions/discover.ts",
    "probe": "tsx --env-file-if-exists=.env src/actions/probe.ts",
    "check:structured": "tsx --env-file-if-exists=.env src/actions/check-structured.ts",
    "backfill-costs": "tsx --env-file-if-exists=.env src/actions/backfill-costs.ts",
    "measure-reuse": "tsx --env-file-if-exists=.env src/actions/measure-reuse.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:live": "node --import tsx --test \"test/live/*.live.ts\"",
    "build": "tsc",
    "panel-server": "tsx --env-file-if-exists=.env src/actions/panel-server.ts",
    "compare-segmentation": "tsx --env-file-if-exists=.env src/actions/compare-segmentation.ts",
    "diff-runs": "tsx src/actions/diff-runs.ts",
    "source-yield": "tsx --env-file-if-exists=.env src/actions/source-yield.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "dom-serializer": "^2.0.0",
    "domhandler": "^5.0.3",
    "domutils": "^3.2.2",
    "html-to-text": "^9.0.5",
    "htmlparser2": "^8.0.2",
    "unpdf": "^0.12.1"
  },
  "optionalDependencies": {
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.0.0",
    "eslint": "^10.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0"
  }
}
