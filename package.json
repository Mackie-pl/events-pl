{
  "name": "events-pl",
  "version": "0.3.0",
  "type": "module",
  "description": "2-stage local events aggregation pipeline (discovery + daily extraction) via OpenRouter",
  "repository": "github:Mackie-pl/events-pl",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "daily": "tsx --env-file-if-exists=.env src/actions/daily.ts",
    "digest": "tsx --env-file-if-exists=.env src/actions/digest.ts",
    "discover": "tsx --env-file-if-exists=.env src/actions/discover.ts",
    "probe": "tsx --env-file-if-exists=.env src/actions/probe.ts",
    "backfill-costs": "tsx --env-file-if-exists=.env src/actions/backfill-costs.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "build": "tsc",
    "panel-server": "tsx --env-file-if-exists=.env src/actions/panel-server.ts"
  },
  "dependencies": {
    "html-to-text": "^9.0.5",
    "unpdf": "^0.12.1"
  },
  "optionalDependencies": {
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.0.0",
    "eslint": "^10.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0"
  }
}
